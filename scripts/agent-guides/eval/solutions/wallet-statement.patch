+#[test]
+fn the_statement_lists_each_deposit_and_withdrawal_with_the_balance_after_it() {
+    GivenProjectionEvents::<WalletStatement>::new()
+        .events([
+            WalletEvent::Deposited(DepositedPayload {
+                wallet_id: "a".into(),
+                amount: 100,
+            }),
+            WalletEvent::Withdrawn(WithdrawnPayload {
+                wallet_id: "a".into(),
+                amount: 30,
+            }),
+            WalletEvent::Deposited(DepositedPayload {
+                wallet_id: "a".into(),
+                amount: 5,
+            }),
+        ])
+        .then(|state| {
+            assert_eq!(
+                state.entries,
+                vec![
+                    entry("deposit", 100, 100),
+                    entry("withdrawal", 30, 70),
+                    entry("deposit", 5, 75),
+                ]
+            );
+        });
+}
+
+#[test]
+fn a_wallet_without_transactions_has_an_empty_statement() {
+    let state = WalletStatementState::default();
+    assert!(state.entries.is_empty());
+}
+
+#[test]
+fn each_transaction_belongs_to_its_own_wallets_statement() {
+    use skilj::Projection;
+    let deposit = WalletEvent::Deposited(DepositedPayload {
+        wallet_id: "b".into(),
+        amount: 1,
+    });
+    assert_eq!(WalletStatement::keys(&deposit), vec!["b".to_string()]);
+}
