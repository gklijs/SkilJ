+
+/// One line of a wallet's statement: a deposit or a withdrawal, and the
+/// balance after it.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+pub struct StatementEntry {
+    /// `"deposit"` or `"withdrawal"`.
+    pub kind: String,
+    /// Positive for both kinds.
+    pub amount: i64,
+    pub balance: i64,
+}
+
+#[derive(Debug, Default, Serialize, Deserialize, JsonSchema)]
+pub struct WalletStatementState {
+    /// In the order they happened.
+    pub entries: Vec<StatementEntry>,
+}
+
+/// Keyed by `wallet_id`, like `Balance`, and `sync: true` for the same
+/// reason: it is up to date as soon as a command is accepted.
+pub struct WalletStatement;
+
+#[auto_register(BOUNDED_CONTEXT)]
+impl Projection for WalletStatement {
+    type State = WalletStatementState;
+    type Event = WalletEvent;
+    const NAME: &'static str = "WalletStatement";
+    fn consumed_event_types() -> Vec<&'static str> {
+        vec!["Deposited", "Withdrawn"]
+    }
+    fn sync() -> bool {
+        true
+    }
+    fn keys(event: &Self::Event) -> Vec<String> {
+        match event {
+            WalletEvent::Deposited(p) => vec![p.wallet_id.clone()],
+            WalletEvent::Withdrawn(p) => vec![p.wallet_id.clone()],
+        }
+    }
+    fn project(state: &mut Self::State, event: &Self::Event, _key: &str) {
+        let before = state.entries.last().map_or(0, |entry| entry.balance);
+        let entry = match event {
+            WalletEvent::Deposited(p) => StatementEntry {
+                kind: "deposit".into(),
+                amount: p.amount,
+                balance: before + p.amount,
+            },
+            WalletEvent::Withdrawn(p) => StatementEntry {
+                kind: "withdrawal".into(),
+                amount: p.amount,
+                balance: before - p.amount,
+            },
+        };
+        state.entries.push(entry);
+    }
+}
