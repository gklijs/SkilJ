@@ -0,0 +1,19 @@
+//! Generates the `savings` bounded context's events and commands from
+//! `src/savings.skilj.toml` (imported from `models/savings.em.json` with
+//! `skilj-codegen import --from em-json`) into `$OUT_DIR`, where
+//! `src/savings.rs` includes them. Runs on every build that changes the
+//! file, so the Rust can't drift from the model.
+
+use std::path::PathBuf;
+
+fn main() {
+    let toml_path = "src/savings.skilj.toml";
+    println!("cargo:rerun-if-changed={toml_path}");
+    let toml_source = std::fs::read_to_string(toml_path)
+        .unwrap_or_else(|e| panic!("failed to read {toml_path}: {e}"));
+    let generated = skilj_codegen::generate(&toml_source)
+        .unwrap_or_else(|e| panic!("skilj-codegen failed on {toml_path}: {e}"));
+    let out_dir = PathBuf::from(std::env::var("OUT_DIR").expect("cargo always sets OUT_DIR"));
+    std::fs::write(out_dir.join("savings_generated.rs"), generated)
+        .unwrap_or_else(|e| panic!("failed to write savings_generated.rs: {e}"));
+}
