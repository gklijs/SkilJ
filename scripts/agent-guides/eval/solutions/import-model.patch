diff -ruN a/src/savings.rs b/src/savings.rs
--- a/src/savings.rs
+++ b/src/savings.rs
@@ -0,0 +1,88 @@
+//! Savings goals, as the team modeled them (`models/savings.em.json`):
+//! a goal is opened, saved towards, and closed. The events and commands
+//! are generated from `src/savings.skilj.toml` by `build.rs`; what each
+//! command decides is written here, one `decide_<name>` per command, after
+//! the model's specifications.
+
+use skilj_core::shared::{CommandDecision, EventSpec};
+
+include!(concat!(env!("OUT_DIR"), "/savings_generated.rs"));
+
+/// Whether the goal was opened, and whether it is closed, from the goal's
+/// own events (its tag selected them).
+fn goal_state(matching_events: &[SavingsEvent]) -> (bool, bool) {
+    matching_events
+        .iter()
+        .fold((false, false), |(opened, closed), event| match event {
+            SavingsEvent::GoalOpened(_) => (true, closed),
+            SavingsEvent::SavedTowardsGoal(_) => (opened, closed),
+            SavingsEvent::GoalClosed(_) => (opened, true),
+        })
+}
+
+/// The model's rejections: `goal_not_found`, `goal_closed`.
+fn open_goal_or_rejection(
+    goal_id: &str,
+    matching_events: &[SavingsEvent],
+) -> Option<CommandDecision> {
+    match goal_state(matching_events) {
+        (false, _) => Some(CommandDecision::Rejected {
+            reason: format!("there is no goal {goal_id}"),
+            kind: "goal_not_found".into(),
+        }),
+        (true, true) => Some(CommandDecision::Rejected {
+            reason: format!("goal {goal_id} is closed"),
+            kind: "goal_closed".into(),
+        }),
+        (true, false) => None,
+    }
+}
+
+fn decide_open_goal(
+    payload: &OpenGoalPayload,
+    _matching_events: &[SavingsEvent],
+) -> CommandDecision {
+    CommandDecision::Accepted {
+        events: vec![EventSpec {
+            event_type: "GoalOpened".into(),
+            payload: serde_json::json!({
+                "goal_id": payload.goal_id,
+                "name": payload.name,
+                "target_amount": payload.target_amount,
+            }),
+        }],
+    }
+}
+
+fn decide_save_towards_goal(
+    payload: &SaveTowardsGoalPayload,
+    matching_events: &[SavingsEvent],
+) -> CommandDecision {
+    if let Some(rejection) = open_goal_or_rejection(&payload.goal_id, matching_events) {
+        return rejection;
+    }
+    CommandDecision::Accepted {
+        events: vec![EventSpec {
+            event_type: "SavedTowardsGoal".into(),
+            payload: serde_json::json!({
+                "goal_id": payload.goal_id,
+                "amount": payload.amount,
+            }),
+        }],
+    }
+}
+
+fn decide_close_goal(
+    payload: &CloseGoalPayload,
+    matching_events: &[SavingsEvent],
+) -> CommandDecision {
+    if let Some(rejection) = open_goal_or_rejection(&payload.goal_id, matching_events) {
+        return rejection;
+    }
+    CommandDecision::Accepted {
+        events: vec![EventSpec {
+            event_type: "GoalClosed".into(),
+            payload: serde_json::json!({ "goal_id": payload.goal_id }),
+        }],
+    }
+}
diff -ruN a/src/savings.skilj.toml b/src/savings.skilj.toml
--- a/src/savings.skilj.toml
+++ b/src/savings.skilj.toml
@@ -0,0 +1,63 @@
+# Imported from Event Modeling JSON by skilj-codegen import --from em-json.
+# Command decisions stay hand-written: one decide_<name> function per command.
+
+bounded_context = "savings"
+
+[[event_type]]
+# From Goal Opened (5100000000000000012)
+name = "GoalOpened"
+fields = [
+    { name = "goal_id", type = "string" },
+    { name = "name", type = "string" },
+    { name = "target_amount", type = "i64" },
+]
+tags = { goal_id = "goal_id" }
+
+[[event_type]]
+# From Saved Towards Goal (5100000000000000022)
+name = "SavedTowardsGoal"
+fields = [
+    { name = "goal_id", type = "string" },
+    { name = "amount", type = "i64" },
+]
+tags = { goal_id = "goal_id" }
+
+[[event_type]]
+# From Goal Closed (5100000000000000032)
+name = "GoalClosed"
+fields = [
+    { name = "goal_id", type = "string" },
+]
+tags = { goal_id = "goal_id" }
+
+[[command_type]]
+# From Open Goal (5100000000000000011)
+name = "OpenGoal"
+rest_trigger_allowed = true
+fields = [
+    { name = "goal_id", type = "string" },
+    { name = "name", type = "string" },
+    { name = "target_amount", type = "i64" },
+]
+tags = { goal_id = "goal_id" }
+
+# Rejected as: goal_closed, goal_not_found
+[[command_type]]
+# From Save Towards Goal (5100000000000000021)
+name = "SaveTowardsGoal"
+rest_trigger_allowed = true
+fields = [
+    { name = "goal_id", type = "string" },
+    { name = "amount", type = "i64" },
+]
+tags = { goal_id = "goal_id" }
+
+# Rejected as: goal_closed, goal_not_found
+[[command_type]]
+# From Close Goal (5100000000000000031)
+name = "CloseGoal"
+rest_trigger_allowed = true
+fields = [
+    { name = "goal_id", type = "string" },
+]
+tags = { goal_id = "goal_id" }
diff -ruN a/tests/savings_fixture.rs b/tests/savings_fixture.rs
--- a/tests/savings_fixture.rs
+++ b/tests/savings_fixture.rs
@@ -0,0 +1,98 @@
+//! The `savings` bounded context's decisions, after the model's
+//! specifications (models/savings.em.json).
+
+use skilj_core::shared::EventSpec;
+use skilj_test_fixture::command::GivenEvents;
+use template_check::savings::{
+    CloseGoal, CloseGoalPayload, GoalClosedPayload, GoalOpenedPayload, OpenGoal, OpenGoalPayload,
+    SaveTowardsGoal, SaveTowardsGoalPayload, SavingsEvent,
+};
+
+fn opened() -> SavingsEvent {
+    SavingsEvent::GoalOpened(GoalOpenedPayload {
+        goal_id: "g".into(),
+        name: "Holiday".into(),
+        target_amount: 500,
+    })
+}
+
+fn closed() -> SavingsEvent {
+    SavingsEvent::GoalClosed(GoalClosedPayload {
+        goal_id: "g".into(),
+    })
+}
+
+fn save(amount: i64) -> SaveTowardsGoalPayload {
+    SaveTowardsGoalPayload {
+        goal_id: "g".into(),
+        amount,
+    }
+}
+
+#[test]
+fn goal_opened() {
+    GivenEvents::<OpenGoal>::new()
+        .when(OpenGoalPayload {
+            goal_id: "g".into(),
+            name: "Holiday".into(),
+            target_amount: 500,
+        })
+        .then_accepted(vec![EventSpec {
+            event_type: "GoalOpened".into(),
+            payload: serde_json::json!({ "goal_id": "g", "name": "Holiday", "target_amount": 500 }),
+        }]);
+}
+
+#[test]
+fn saved_towards_an_open_goal() {
+    GivenEvents::<SaveTowardsGoal>::new()
+        .event(opened())
+        .when(save(50))
+        .then_accepted(vec![EventSpec {
+            event_type: "SavedTowardsGoal".into(),
+            payload: serde_json::json!({ "goal_id": "g", "amount": 50 }),
+        }]);
+}
+
+#[test]
+fn saving_towards_no_such_goal_is_rejected() {
+    GivenEvents::<SaveTowardsGoal>::new()
+        .when(save(50))
+        .then_rejected("goal_not_found");
+}
+
+#[test]
+fn saving_towards_a_closed_goal_is_rejected() {
+    GivenEvents::<SaveTowardsGoal>::new()
+        .events([opened(), closed()])
+        .when(save(50))
+        .then_rejected("goal_closed");
+}
+
+#[test]
+fn an_open_goal_is_closed() {
+    GivenEvents::<CloseGoal>::new()
+        .event(opened())
+        .when(CloseGoalPayload {
+            goal_id: "g".into(),
+        })
+        .then_accepted(vec![EventSpec {
+            event_type: "GoalClosed".into(),
+            payload: serde_json::json!({ "goal_id": "g" }),
+        }]);
+}
+
+#[test]
+fn closing_a_closed_goal_or_none_is_rejected() {
+    GivenEvents::<CloseGoal>::new()
+        .events([opened(), closed()])
+        .when(CloseGoalPayload {
+            goal_id: "g".into(),
+        })
+        .then_rejected("goal_closed");
+    GivenEvents::<CloseGoal>::new()
+        .when(CloseGoalPayload {
+            goal_id: "g".into(),
+        })
+        .then_rejected("goal_not_found");
+}
