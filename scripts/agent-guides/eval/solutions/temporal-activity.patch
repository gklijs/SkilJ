+    /// A wallet is opened once, so it starts one onboarding workflow.
+    fn decide(payload: &Self::Payload, matching_events: &[Self::Event]) -> CommandDecision {
+        let open = matching_events
+            .iter()
+            .any(|event| matches!(event, WalletEvent::WalletOpened(_)));
+        if open {
+            return CommandDecision::Rejected {
+                reason: format!("wallet {} is open already", payload.wallet_id),
+                kind: "wallet_already_open".into(),
+            };
+        }
+        CommandDecision::Accepted {
+            events: vec![EventSpec {
+                event_type: "WalletOpened".into(),
+                payload: serde_json::json!({
+                    "wallet_id": payload.wallet_id,
+                    "owner_id": payload.owner_id,
+                }),
+            }],
+        }
+    }
+}
