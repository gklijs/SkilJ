@@ -0,0 +1,60 @@
+//! Opening a wallet, and the mapping that onboards it.
+
+use skilj::EventType;
+use skilj_core::shared::EventSpec;
+use skilj_temporal::MappingAction;
+use skilj_test_fixture::command::GivenEvents;
+use template_check::onboarding::onboarding_mapping;
+use template_check::wallet::{
+    OpenWallet, OpenWalletPayload, WalletEvent, WalletOpened, WalletOpenedPayload,
+};
+
+fn open() -> OpenWalletPayload {
+    OpenWalletPayload {
+        wallet_id: "a".into(),
+        owner_id: "o-1".into(),
+    }
+}
+
+#[test]
+fn a_new_wallet_is_opened() {
+    GivenEvents::<OpenWallet>::new()
+        .when(open())
+        .then_accepted(vec![EventSpec {
+            event_type: "WalletOpened".into(),
+            payload: serde_json::json!({ "wallet_id": "a", "owner_id": "o-1" }),
+        }]);
+}
+
+#[test]
+fn an_open_wallet_is_not_opened_again() {
+    GivenEvents::<OpenWallet>::new()
+        .event(WalletEvent::WalletOpened(WalletOpenedPayload {
+            wallet_id: "a".into(),
+            owner_id: "o-1".into(),
+        }))
+        .when(open())
+        .then_rejected("wallet_already_open");
+}
+
+#[test]
+fn an_opened_wallet_starts_its_onboarding_workflow() {
+    let mapping = onboarding_mapping("id.secret".into());
+    assert_eq!(mapping.event_type, "WalletOpened");
+    assert_eq!(mapping.credential, "id.secret");
+    assert_eq!(mapping.correlation_tag_key, "wallet");
+    let MappingAction::Start {
+        workflow_type,
+        task_queue,
+    } = mapping.action
+    else {
+        panic!("WalletOpened starts a workflow");
+    };
+    assert_eq!(workflow_type, "WalletOnboarding");
+    assert_eq!(task_queue, "wallet-onboarding");
+}
+
+#[test]
+fn the_bridge_may_read_wallet_opened() {
+    assert!(WalletOpened::event_read_allowed());
+}
