+) -> Result<temporalio_client::Client, Box<dyn std::error::Error>> {
+    use temporalio_client::{Client, ClientOptions, Connection, ConnectionOptions};
+    let url: temporalio_client::Url = format!("http://{address}").parse()?;
+    let connection = Connection::connect(ConnectionOptions::new(url).build()).await?;
+    Ok(Client::new(connection, ClientOptions::new("default").build())?)
