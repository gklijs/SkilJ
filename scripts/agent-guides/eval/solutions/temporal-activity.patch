+//! Every opened wallet is onboarded by a Temporal workflow: the
+//! `skilj-temporal` bridge reads `WalletOpened` over REST and starts a
+//! `WalletOnboarding` execution for it, correlated by the wallet's tag
+//! (workflow id `wallet:wallet:<wallet_id>`). The workflow itself runs on
+//! another team's workers.
+
+use skilj_temporal::{EventTypeMapping, MappingAction};
+
+/// The workflow type each opened wallet starts.
+pub const WORKFLOW_TYPE: &str = "WalletOnboarding";
+/// The task queue its workers poll.
+pub const TASK_QUEUE: &str = "wallet-onboarding";
+
+/// `WalletOpened` starts `WalletOnboarding` on `wallet-onboarding`, one
+/// execution per wallet. `credential` is an event read token for
+/// `WalletOpened` (`<id>.<secret>`).
+pub fn onboarding_mapping(credential: String) -> EventTypeMapping {
+    EventTypeMapping {
+        event_type: "WalletOpened".to_string(),
+        credential,
+        correlation_tag_key: "wallet".to_string(),
+        action: MappingAction::Start {
+            workflow_type: WORKFLOW_TYPE.to_string(),
+            task_queue: TASK_QUEUE.to_string(),
+        },
+    }
+}
