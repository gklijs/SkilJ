 #[test]
+fn deposit_records_its_reference() {
+    GivenCommandEvents::<Deposit>::new()
+        .when(DepositPayload {
+            wallet_id: "a".into(),
+            amount: 100,
+            reference: Some("rent".into()),
+        })
+        .then_accepted(vec![EventSpec {
+            event_type: "Deposited".into(),
+            payload: serde_json::json!({ "wallet_id": "a", "amount": 100, "reference": "rent" }),
+        }]);
+}
+
+#[test]
+fn deposit_stored_before_references_still_reads() {
+    let stored = serde_json::json!({ "wallet_id": "a", "amount": 100 });
+    let payload: DepositedPayload = serde_json::from_value(stored).unwrap();
+    assert_eq!(payload.reference, None);
+}
