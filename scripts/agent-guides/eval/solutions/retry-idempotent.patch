+//! `deposit <base_url> <token> <wallet_id> <amount> <deposit_id>`: one
+//! deposit through the client, retried as it retries; prints the answer.
+
+use std::process::ExitCode;
+
+#[tokio::main]
+async fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let [base_url, token, wallet_id, amount, deposit_id] = args.as_slice() else {
+        eprintln!("usage: deposit <base_url> <token> <wallet_id> <amount> <deposit_id>");
+        return ExitCode::from(2);
+    };
+    let Ok(amount) = amount.parse::<i64>() else {
+        eprintln!("deposit: the amount must be a whole number, not {amount}");
+        return ExitCode::from(2);
+    };
+    match template_check::client::deposit(base_url, token, wallet_id, amount, deposit_id).await {
+        Ok(answer) => {
+            println!("{answer}");
+            ExitCode::SUCCESS
+        }
+        Err(error) => {
+            eprintln!("deposit: {error}");
+            ExitCode::FAILURE
+        }
+    }
+}
