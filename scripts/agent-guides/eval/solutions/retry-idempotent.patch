--- a/src/client.rs
+++ b/src/client.rs
@@ -0,0 +1,96 @@
+//! The payment provider's client: deposits into a wallet over REST, and
+//! retries a request that failed on the way.
+//!
+//! Every attempt for one deposit carries the same `Idempotency-Key`,
+//! derived from the deposit's own id, so the server books it once however
+//! often it arrives. The server remembers a key for its idempotency-key
+//! retention, 48 hours by default (`SkiljBuilder::idempotency_key_retention`):
+//! retrying the same deposit later than that books it again, so keep every
+//! retry of one deposit, this client's and the caller's, within it.
+
+use std::time::Duration;
+
+/// How often a request is sent at most, the first time included.
+const ATTEMPTS: u32 = 5;
+/// The wait before the first retry; it doubles for each next one.
+const FIRST_BACKOFF: Duration = Duration::from_millis(100);
+
+/// Why a deposit was not answered.
+#[derive(Debug)]
+pub enum DepositError {
+    /// The server refused the request (4xx): sending it again won't help.
+    Refused { status: u16, body: String },
+    /// Every attempt failed on the way: a transport error or a 5xx.
+    GaveUp { attempts: u32, last: String },
+}
+
+impl std::fmt::Display for DepositError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            DepositError::Refused { status, body } => write!(f, "refused with {status}: {body}"),
+            DepositError::GaveUp { attempts, last } => {
+                write!(f, "gave up after {attempts} attempts: {last}")
+            }
+        }
+    }
+}
+
+impl std::error::Error for DepositError {}
+
+/// The key one deposit is known by, on every attempt.
+pub fn idempotency_key(deposit_id: &str) -> String {
+    format!("deposit:{deposit_id}")
+}
+
+/// Deposits `amount` into `wallet_id` with a `Deposit` trigger, and
+/// returns the server's answer (the response body). A transport error or
+/// a 5xx is retried, with the same `Idempotency-Key`; a 4xx is not.
+pub async fn deposit(
+    base_url: &str,
+    token: &str,
+    wallet_id: &str,
+    amount: i64,
+    deposit_id: &str,
+) -> Result<String, DepositError> {
+    let client = reqwest::Client::new();
+    let url = format!("{}/v1/commands/trigger", base_url.trim_end_matches('/'));
+    let body = serde_json::json!({ "payload": { "wallet_id": wallet_id, "amount": amount } });
+    let key = idempotency_key(deposit_id);
+    let mut backoff = FIRST_BACKOFF;
+    let mut last = String::new();
+    for attempt in 1..=ATTEMPTS {
+        let sent = client
+            .post(&url)
+            .bearer_auth(token)
+            .header("Idempotency-Key", &key)
+            .json(&body)
+            .send()
+            .await;
+        match sent {
+            Ok(response) => {
+                let status = response.status();
+                let text = response.text().await;
+                match text {
+                    Ok(text) if status.is_success() => return Ok(text),
+                    Ok(text) if status.is_client_error() => {
+                        return Err(DepositError::Refused {
+                            status: status.as_u16(),
+                            body: text,
+                        })
+                    }
+                    Ok(text) => last = format!("{status}: {text}"),
+                    Err(error) => last = format!("{status}, reading the answer failed: {error}"),
+                }
+            }
+            Err(error) => last = error.to_string(),
+        }
+        if attempt < ATTEMPTS {
+            tokio::time::sleep(backoff).await;
+            backoff *= 2;
+        }
+    }
+    Err(DepositError::GaveUp {
+        attempts: ATTEMPTS,
+        last,
+    })
+}
