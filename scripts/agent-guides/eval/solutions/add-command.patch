+pub struct CloseWallet;
+
+#[auto_register(BOUNDED_CONTEXT)]
+impl CommandType for CloseWallet {
+    type Payload = CloseWalletPayload;
+    type Event = WalletEvent;
+    const NAME: &'static str = "CloseWallet";
+    fn tag_mappings() -> Vec<TagMapping> {
+        wallet_tag()
+    }
+    fn rest_trigger_allowed() -> bool {
+        true
+    }
+    fn decide(payload: &Self::Payload, matching_events: &[Self::Event]) -> CommandDecision {
+        if is_closed(matching_events) {
+            return wallet_closed(&payload.wallet_id);
+        }
+        let balance = balance_of(matching_events);
+        if balance != 0 {
+            return CommandDecision::Rejected {
+                reason: format!(
+                    "wallet {} still holds {balance}, withdraw it first",
+                    payload.wallet_id
+                ),
+                kind: "wallet_not_empty".into(),
+            };
+        }
+        CommandDecision::Accepted {
+            events: vec![EventSpec {
+                event_type: "WalletClosed".into(),
+                payload: serde_json::json!({ "wallet_id": payload.wallet_id }),
+            }],
+        }
+    }
+}
