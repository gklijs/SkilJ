+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+pub struct AttachStatementPayload {
+    pub wallet_id: String,
+    pub owner_id: String,
+    pub month: String,
+    pub document: BlobRef,
+}
+
+pub struct AttachStatement;
+
+#[auto_register(BOUNDED_CONTEXT)]
+impl CommandType for AttachStatement {
+    type Payload = AttachStatementPayload;
+    type Event = WalletEvent;
+    const NAME: &'static str = "AttachStatement";
+    fn tag_mappings() -> Vec<TagMapping> {
+        wallet_tag()
+    }
+    fn blob_fields() -> Vec<BlobField> {
+        statement_document()
+    }
+    fn rest_trigger_allowed() -> bool {
+        true
+    }
+    /// One statement per wallet and month; the wallet's tag already
+    /// selected this wallet's events.
+    fn decide(payload: &Self::Payload, matching_events: &[Self::Event]) -> CommandDecision {
+        let attached = matching_events.iter().any(
+            |event| matches!(event, WalletEvent::StatementAttached(p) if p.month == payload.month),
+        );
+        if attached {
+            return CommandDecision::Rejected {
+                reason: format!(
+                    "wallet {} has a statement for {} already",
+                    payload.wallet_id, payload.month
+                ),
+                kind: "statement_already_attached".into(),
+            };
+        }
+        CommandDecision::Accepted {
+            events: vec![EventSpec {
+                event_type: "StatementAttached".into(),
+                payload: serde_json::json!({
+                    "wallet_id": payload.wallet_id,
+                    "owner_id": payload.owner_id,
+                    "month": payload.month,
+                    "document": payload.document,
+                }),
+            }],
+        }
+    }
+}
