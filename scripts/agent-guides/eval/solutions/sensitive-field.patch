+/// The wallet, and the owner as a tag of their own. The owner's id stays
+/// readable: it is what their encryption key is found by.
+fn owner_tags() -> Vec<TagMapping> {
+    vec![
+        TagMapping::new("wallet", "wallet_id"),
+        TagMapping::new("owner", "owner_id"),
+    ]
+}
+
+/// The owner's email address is personal data: encrypted under the
+/// owner's own key, so forgetting the owner makes it unreadable. Declared
+/// on the command as well as on the event, since both are stored.
+fn owner_email() -> Vec<SensitiveField> {
+    vec![SensitiveField::new("email", "owner", "owner_id")]
+}
