+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+pub struct RegisterOwnerPayload {
+    pub wallet_id: String,
+    pub owner_id: String,
+    pub email: String,
+}
+
+pub struct RegisterOwner;
+
+#[auto_register(BOUNDED_CONTEXT)]
+impl CommandType for RegisterOwner {
+    type Payload = RegisterOwnerPayload;
+    type Event = WalletEvent;
+    const NAME: &'static str = "RegisterOwner";
+    fn tag_mappings() -> Vec<TagMapping> {
+        owner_tags()
+    }
+    fn sensitive_fields() -> Vec<SensitiveField> {
+        owner_email()
+    }
+    fn rest_trigger_allowed() -> bool {
+        true
+    }
+    /// Decides on which events matched, never on the email address.
+    fn decide(payload: &Self::Payload, matching_events: &[Self::Event]) -> CommandDecision {
+        let has_owner = matching_events.iter().any(|event| {
+            matches!(event, WalletEvent::OwnerRegistered(p) if p.wallet_id == payload.wallet_id)
+        });
+        if has_owner {
+            return CommandDecision::Rejected {
+                reason: format!("wallet {} already has an owner", payload.wallet_id),
+                kind: "owner_already_registered".into(),
+            };
+        }
+        CommandDecision::Accepted {
+            events: vec![EventSpec {
+                event_type: "OwnerRegistered".into(),
+                payload: serde_json::json!({
+                    "wallet_id": payload.wallet_id,
+                    "owner_id": payload.owner_id,
+                    "email": payload.email,
+                }),
+            }],
+        }
+    }
+}
