+/// An owner's email address is unique across all wallets: a blind tag, the
+/// keyed hash of the normalized address, so the address itself is never
+/// stored in the clear. Forgetting the owner (subject `owner`) removes the
+/// tag, which frees the address.
+pub struct OwnerEmail;
+
+#[auto_register(BOUNDED_CONTEXT)]
+impl BlindTag for OwnerEmail {
+    const TAG_KEY: &'static str = "email";
+    const NORMALIZER_VERSION: u32 = 1;
+    const ERASURE: BlindErasure = BlindErasure::with_subject("owner");
+    fn normalize(value: &str) -> String {
+        normalize::email(value)
+    }
+}
+
+/// The wallet, the owner as the plain tag erasure finds them by, and the
+/// address as a blind tag.
+fn owner_tags() -> Vec<TagMapping> {
+    vec![
+        TagMapping::new("wallet", "wallet_id"),
+        TagMapping::new("owner", "owner_id"),
+        TagMapping::blind::<OwnerEmail>("email"),
+    ]
+}
+
+/// The address is encrypted under the owner's key, on the command as well
+/// as on the event, since both are stored.
+fn owner_email() -> Vec<SensitiveField> {
+    vec![SensitiveField::new("email", "owner", "owner_id")]
+}
