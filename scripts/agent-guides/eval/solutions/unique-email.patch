+/// The blind index key: 32 random bytes, hex in `path`, made on first use.
+fn load_or_create_blind_index_key(
+    path: &std::path::Path,
+) -> Result<skilj::BlindIndexKey, Box<dyn std::error::Error>> {
+    if !path.exists() {
+        // A token secret is 32 of the OS's random bytes, as hex.
+        std::fs::write(path, skilj_core::shared::try_generate_token_secret()?)?;
+    }
+    let hex = std::fs::read_to_string(path)?;
+    let hex = hex.trim();
+    if hex.len() != 64 {
+        return Err(format!("{}: expected 64 hex digits", path.display()).into());
+    }
+    let mut bytes = [0u8; 32];
+    for (i, byte) in bytes.iter_mut().enumerate() {
+        *byte = u8::from_str_radix(&hex[2 * i..2 * i + 2], 16)?;
+    }
+    Ok(skilj::BlindIndexKey::from_bytes(bytes))
+}
